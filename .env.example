# ---------------------------------------------------------------------------
# Texas Grill — environment variables
# Copy this file to .env (dev) and never commit the real .env.
# ---------------------------------------------------------------------------

# Database (Prisma). A managed PostgreSQL connection string (Neon, Supabase,
# Vercel Postgres, RDS...). Get this from your provider's dashboard — for
# Neon: Project > Connect > copy the "psql" / pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v4 — the canonical env var name this library checks internally
# (including its own /api/auth/error page) is NEXTAUTH_SECRET; AUTH_SECRET
# (the newer Auth.js v5 name) is also accepted as a fallback, but set this
# one to avoid a "NO_SECRET" configuration error.
NEXTAUTH_SECRET="replace-with-a-long-random-string" # `openssl rand -base64 32`
# NEXTAUTH_URL is optional — next-auth can auto-detect the deployment URL on
# Vercel (via its VERCEL_URL system env var). Only set this if you're on a
# fixed custom domain and want to pin it explicitly.
# NEXTAUTH_URL="https://your-domain.example"

# OAuth (optional — leave unset to keep email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps — MapProvider abstraction (lib/services/map.ts). Falls back to a
# static placeholder map when unset.
NEXT_PUBLIC_MAP_PROVIDER="STATIC" # STATIC | GOOGLE | MAPBOX
NEXT_PUBLIC_MAP_API_KEY=
MAP_API_KEY=

# Payments — PaymentProvider abstraction (lib/services/payment.ts). MOCK
# always succeeds so checkout is fully testable without a live gateway.
PAYMENT_PROVIDER="MOCK" # MOCK | CINETPAY
PAYMENT_API_KEY=

# Storage — StorageProvider abstraction (lib/services/storage.ts).
STORAGE_PROVIDER="LOCAL" # LOCAL | S3 | CLOUDINARY
STORAGE_API_KEY=

# AI — "Ask Texas" assistant (lib/services/ai.ts). Falls back to a
# deterministic rule-based assistant when unset.
AI_PROVIDER="RULE_BASED" # RULE_BASED | LLM
AI_API_KEY=

# Notifications (lib/services/notifications.ts) — dev adapters log to the
# console until these are configured.
EMAIL_PROVIDER=
SMS_PROVIDER=
WHATSAPP_PROVIDER=

# Cache (optional)
REDIS_URL=

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
